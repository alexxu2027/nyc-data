# Copy to .env only when you reach a phase that needs these. Phase 1 needs NONE.

# Optional: identify yourself to public APIs (NWS asks for a contact). Leave blank for the default.
NYCLIVE_USER_AGENT=

# Optional: raises NYC Open Data (Socrata) rate limits. Free at data.cityofnewyork.us.
SOCRATA_APP_TOKEN=

# Phase 5 extras
OPENAQ_API_KEY=
MTA_BUSTIME_KEY=

# Where collected data lives (default ./data)
NYCLIVE_DATA_DIR=
