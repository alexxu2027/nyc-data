# Copy to .env only when you reach a phase that needs these. Phase 1 needs NONE.

# Optional: identify yourself to public APIs (NWS asks for a contact). Leave blank for the default.
NYCLIVE_USER_AGENT=

# Optional: raises NYC Open Data (Socrata) rate limits. Free at data.cityofnewyork.us.
SOCRATA_APP_TOKEN=

# Optional keyed extras (ADR-018). Each one adds a layer; leave blank and it's simply not there.
# Air quality: free key at explore.openaq.org/register (sent as a header).
OPENAQ_API_KEY=
# Live buses: free key at register.developer.obanyc.com (arrives by email).
MTA_BUSTIME_KEY=
# 511NY traffic events: access by request form (511ny.org/help/24). Not collected yet.
NY511_API_KEY=

# Where collected data lives (default ./data)
NYCLIVE_DATA_DIR=
